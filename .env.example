POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme-generate-a-real-secret

# Only needed on hosts where the arm64 build of ghcr.io/cirruslabs/flutter:stable
# is broken (e.g. Docker Desktop on Apple Silicon). Leave unset on native arm64
# Linux hosts (e.g. an ARM cloud VM) — forcing amd64 there runs the build under
# QEMU emulation and segfaults.
# FLUTTER_IMAGE_PLATFORM=linux/amd64
