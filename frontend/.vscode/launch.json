{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "finance_dashboard (Chrome)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=API_BASE_URL=http://localhost:8000/"
      ]
    },
    {
      "name": "finance_dashboard (macOS)",
      "request": "launch",
      "type": "dart",
      "deviceId": "macos",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=API_BASE_URL=http://localhost:8000/"
      ]
    },
    {
      "name": "finance_dashboard (Profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=API_BASE_URL=http://localhost:8000/"
      ]
    }
  ]
}
